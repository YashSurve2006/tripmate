# ==============================================================================
# TripMate — Root Git Ignore Configuration
# ==============================================================================

# Dependencies
node_modules/
.pnp/
.pnp.js

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Build Outputs & Generated Caches
dist/
build/
.expo/
web-build/
.next/
*.tsbuildinfo
expo-env.d.ts

# Android Gradle Build Intermediates & Caches
.gradle/
.cxx/
.kotlin/
**/build/
**/local.properties
gradle/gradle-daemon-jvm.properties
*.iml
*.hprof

# Standalone Android Installable Binaries (Keep local; release separately)
*.apk
*.aab
TripMate-release.apk

# Android Keystores & Signing Credentials (allow public React Native debug key for clone builds)
*.jks
*.keystore
!**/debug.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# SQLite Databases & Local Storage
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# User Uploaded Receipts, Documents & Local Data Exports
uploads/
receipts/
*.xlsx

# Metro & Bundler Caches
.metro-health-check*
*.jsbundle

# IDEs & System Files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
.claude/
*.swp
*.swo
.offline-markdown-preview/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
