datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum GroupType {
  TRIP
  ROOMMATES
  OUTING
  EVENT
  OTHER
}

enum MemberRole {
  ADMIN
  MEMBER
}

enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
}

enum ExpenseCategory {
  FOOD_AND_DRINK
  TRANSPORT
  ACCOMMODATION
  ENTERTAINMENT
  SHOPPING
  GROCERIES
  FLIGHTS
  UTILITIES
  OTHER
}

enum SettlementStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  passwordHash     String
  name             String
  avatarUrl        String?
  upiId            String?
  currencyPref     String          @default("INR")
  themePref        String          @default("system")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  memberships      GroupMember[]
  createdGroups    Group[]         @relation("GroupCreator")
  createdExpenses  Expense[]       @relation("ExpenseCreator")
  payments         ExpensePayment[]
  splits           ExpenseSplit[]
  settlementsPaid  Settlement[]    @relation("SettlementPayer")
  settlementsRecv  Settlement[]    @relation("SettlementPayee")
  activities       Activity[]

  @@index([email])
}

model Group {
  id           String        @id @default(uuid())
  name         String
  description  String?
  type         GroupType     @default(TRIP)
  currency     String        @default("INR")
  budgetPaise  BigInt?       // in integer minor units (paise)
  startDate    DateTime?
  endDate      DateTime?
  inviteCode   String        @unique @default(uuid())
  createdById  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  createdBy    User          @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members      GroupMember[]
  expenses     Expense[]
  settlements  Settlement[]
  activities   Activity[]

  @@index([createdById])
  @@index([inviteCode])
}

model GroupMember {
  id        String     @id @default(uuid())
  groupId   String
  userId    String
  role      MemberRole @default(MEMBER)
  joinedAt  DateTime   @default(now())

  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model Expense {
  id             String          @id @default(uuid())
  groupId        String
  title          String
  notes          String?
  amountPaise    BigInt          // integer minor units (paise)
  currency       String          @default("INR")
  category       ExpenseCategory @default(FOOD_AND_DRINK)
  date           DateTime        @default(now())
  receiptUrl     String?
  latitude       Float?
  longitude      Float?
  idempotencyKey String?         @unique
  createdById    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  group          Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy      User            @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  payments       ExpensePayment[]
  splits         ExpenseSplit[]

  @@index([groupId])
  @@index([createdById])
  @@index([date])
}

model ExpensePayment {
  id          String   @id @default(uuid())
  expenseId   String
  userId      String
  amountPaise BigInt   // integer minor units (paise)

  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([userId])
}

model ExpenseSplit {
  id          String    @id @default(uuid())
  expenseId   String
  userId      String
  amountPaise BigInt    // integer minor units (paise)
  splitType   SplitType @default(EQUAL)
  percentage  Float?

  expense     Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([userId])
}

model Settlement {
  id          String           @id @default(uuid())
  groupId     String
  payerId     String
  payeeId     String
  amountPaise BigInt           // integer minor units (paise)
  currency    String           @default("INR")
  status      SettlementStatus @default(PENDING)
  notes       String?
  proofUrl    String?
  confirmedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  group       Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer       User             @relation("SettlementPayer", fields: [payerId], references: [id], onDelete: Restrict)
  payee       User             @relation("SettlementPayee", fields: [payeeId], references: [id], onDelete: Restrict)

  @@index([groupId])
  @@index([payerId])
  @@index([payeeId])
}

model Activity {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  action    String   // e.g., "EXPENSE_CREATED", "SETTLEMENT_RECORDED", "MEMBER_JOINED"
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([userId])
}
