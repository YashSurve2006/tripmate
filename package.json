{
  "name": "tripmate",
  "version": "1.0.0",
  "private": true,
  "description": "TripMate - Production-ready Android-first group expense and trip management application",
  "scripts": {
    "start:mobile": "npm --prefix apps/mobile start",
    "android": "npm --prefix apps/mobile run android",
    "build:apk": "node scripts/build-apk.js release",
    "build:apk:debug": "node scripts/build-apk.js debug",
    "start:backend": "npm --prefix apps/backend run dev",
    "build:shared": "npm --prefix packages/shared run build",
    "typecheck:shared": "npm --prefix packages/shared run build",
    "typecheck:backend": "npm --prefix apps/backend run build",
    "typecheck:mobile": "npm --prefix apps/mobile run typecheck",
    "typecheck": "npm run typecheck:shared && npm run typecheck:backend && npm run typecheck:mobile",
    "test:shared": "npm --prefix packages/shared test",
    "test:backend": "npm --prefix apps/backend test",
    "test:e2e": "npx tsx apps/mobile/src/services/export/test-features-e2e.ts",
    "test": "npm run test:shared && npm run test:backend && npm run test:e2e"
  },
  "keywords": [
    "expense-tracker",
    "splitwise-alternative",
    "trips",
    "react-native",
    "expo",
    "offline-first",
    "sqlite"
  ],
  "author": "Yash Surve <yashsurve2019@gmail.com>",
  "license": "MIT"
}
